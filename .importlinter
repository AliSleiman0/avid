# Architecture enforcement (SDS §3.2, §3.4; principles P1, P2, P5). AVID-3.
#
# Run: `uv run lint-imports`. This is the load-bearing gate — reviewers get tired,
# import-linter does not (CONTRIBUTING §"CI quality gates"). Until CI (AVID-4)
# lands it is hand-run alongside the other quality gates.

[importlinter]
root_package = avid
# Required so the domain-purity forbidden contract can graph imports that leave
# avid (numpy, openai, …). Without it, external forbidden modules are invisible.
include_external_packages = True

[importlinter:contract:layers]
name = Dependencies point inward only (P1, P5)
type = layers
layers =
    avid.main
    avid.adapters
    avid.services
    avid.core
    avid.domain
# A higher layer may import a lower one; never the reverse. This single contract
# also enforces P2 — services / core / domain cannot import avid.adapters, because
# adapters sits above them. If you are fighting this, logic is in the wrong layer:
# move the logic, do not weaken the rule.

[importlinter:contract:domain-purity]
name = Domain imports nothing heavy or third-party (P1)
type = forbidden
source_modules =
    avid.domain
forbidden_modules =
    numpy
    pygame
    sqlite3
    asyncio
    openai
    cv2
    dateutil
# The domain is pure: stdlib plus pydantic only (CLAUDE.md §2). If you want
# `import numpy` here, the logic belongs in a service or an adapter.
#
# `dateutil` is listed even though it became a *core runtime* dependency at M10
# (SDS §10.3, RFC 5545 recurrence) -- which is precisely why it is listed. A
# dependency the whole tree may import is one an idle refactor can drift into
# `domain/` without anything complaining; the resolver lives in
# `core/schedule.py` and this line is what keeps it there.
#
# `pygame` is a standing rule, not an aspiration: ADR-012 (SDS §3.6.4) decided
# faces compose to RGB888 bytes in the stdlib, so no drawing library belongs in
# the composition path. Note the scope — `source_modules` is `avid.domain`, so
# this forbids pygame *in the domain*, which holds regardless of backend. A
# future HDMI/SDL display adapter may still take pygame as an adapter-local
# optional dependency, exactly as `picamera2` and `pyalsaaudio` do today.

[importlinter:contract:affect-state-orthogonality]
name = Affect and RobotState are orthogonal (AVID-8; SDS §3.10.1)
type = independence
modules =
    avid.domain.affect
    avid.domain.state
# Emotional state (Affect) and operational state (RobotState) are deliberately
# decoupled (SDS §3.10.1, CLAUDE.md §5). Neither module may import the other;
# conflating them is the most common design error in this class of project. This
# makes the "nothing in domain/ couples them" rule mechanical, not review-hope.

[importlinter:contract:service-independence]
name = Services do not import each other (P5)
type = independence
modules =
    avid.services.affect
    avid.services.audio
    avid.services.behavior
    avid.services.conversation
    avid.services.drive
    avid.services.episode_recorder
    avid.services.expression
    avid.services.memory
    avid.services.motion
    avid.services.observability
    avid.services.presence
# P5: no module reaches through another — cross-module effect happens via the bus,
# never an import. `services.cue_bank` is deliberately NOT listed: it is a shared
# collaborator the port-owning service *calls* (SDS §6.9, like `core/affect_map`),
# not a peer service that reaches sideways — `conversation` importing it is the
# intended pattern, and cue_bank itself imports only `core`/`domain`, so it opens no
# indirect path between the listed services.
#
# Dormant since M0 for want of real service modules; activated by
# AVID-73 now that two exist. **Add one line per service as it arrives** (M4 audio,
# M6 behavior, M8 vision, M9 motion, memory) — a service missing from this list is
# unguarded, and the list is the only thing that makes P5 mechanical.
#
# Why this passes today, which is not an accident: both services need the Tier-1
# RobotState->Affect table, and AVID-72 moved it OUT of `services/affect.py` into
# `core/affect_map.py` precisely so they could share it without an edge between them.
# It cannot live in `domain/` either — `affect-state-orthogonality` above forbids a
# domain module knowing both halves. If a future change "tidies" that table back into
# a service, this contract is what breaks, and the fix is to move the shared thing
# down a layer, never to import sideways.
#
# Note this is an INDEPENDENCE contract, so it catches INDIRECT chains too: a shared
# helper that itself imports a service would couple them just as surely as a direct
# import, and would fail here.
