# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# uv / virtualenv
.venv/
venv/
# .python-version IS committed — it pins the dev interpreter (ADR-008: 3.13)

# Test / coverage / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Runtime artifacts (FakeDisplay frames, hal_pi.py bench evidence, etc.)
.artifacts/
docs/demos/hal_pi_out/

# ONNX model blobs (#119, #221). The real destination is /var/lib/robot/models on the
# device; this covers `tools/fetch_*.py --dest ./models`, the local dry run. Never
# committed: the largest tracked file here is 566 KB, there is no LFS, and MiniLM alone
# is 86 MB. The fetch scripts pin a revision and verify a SHA-256 instead.
models/

# Databases (on-device memory — never committed)
*.db
*.db-wal
*.db-shm

# Secrets / local env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# SPK-1 spike: regenerable TTS audio cache
spikes/**/audio_cache/
