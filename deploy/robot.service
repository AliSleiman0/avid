[Unit]
Description=Pico (Avid) companion robot
Documentation=https://github.com/AliSleiman0/avid
# M1 is offline (all-fake adapters, realtime=replay) so loopback is enough. Switch
# to network-online.target at M2, when the Realtime WSS connection matters.
After=network.target
# Never give up restarting. SDS §3.12.3: nothing but a bad API key at boot is
# allowed to stop the robot; disabling the start-rate limiter honours that.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=robot
Group=robot
WorkingDirectory=/opt/avid
# ⚠️ lgpio — reached via adafruit_blinka, under adafruit_servokit, under Pca9685Servo — creates
# `.lgd-nfy-N` notification files in the process's CURRENT WORKING DIRECTORY. That is
# /opt/avid above, which ProtectSystem=strict makes read-only, so EVERY servo write failed
# with `FileNotFoundError: '.lgd-nfy-3'` and the robot was motionless under the unit (#207).
# LG_WD moves them to the one path this service can write. StateDirectory=robot creates it.
Environment=LG_WD=/var/lib/robot
ExecStart=/opt/avid/.venv/bin/python -m avid --config /etc/robot/config.toml
Restart=always
RestartSec=5
# Half the WatchdogSec so WATCHDOG=1 pings twice per period. Must stay consistent
# with config/pi.toml [systemd] watchdog_interval_s = 15.0 (enforced in CI by
# tests/deploy/test_robot_service.py).
WatchdogSec=30
SyslogIdentifier=avid
# Optional (leading '-'); M1 needs no key. At M2 put OPENAI_API_KEY in this file,
# root-owned 0600 — never in the unit or in config.toml (P7 / SECURITY.md).
EnvironmentFile=-/etc/robot/robot.env

# --- Hardening (SDS §3.11.3) ---
# AF_UNIX for sd_notify to $NOTIFY_SOCKET; AF_INET/AF_INET6 for the loopback
# health server (127.0.0.1:8787). Nothing else is needed.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The `robot` nologin user needs the `video` group to open the CSI camera device
# (/dev/video*, /dev/media*) and `gpio` for the servos — PrivateDevices is left off so
# those /dev nodes are reachable, and group membership is the gate (AVID-51 camera, M2).
#
# `audio` is not optional either, and its absence was invisible for two milestones: without
# it the service opens NO sound card at all — `AudioService.mic_loop` dies at startup with
# `ALSAAudioError: No such device [plughw:CARD=Device,DEV=0]` while the process still reaches
# IDLE and reports healthy, so the robot runs deaf and mute and says so nowhere. M4 and M5
# both passed because their benches run as the *login* user, which is in `audio`; the service
# audio path had never actually worked. Found at the M7 gate prep, where AC-2's
# `systemctl restart` makes running-as-the-service unavoidable.
# `i2c` is the third member of this list to be discovered missing on hardware, and the third
# time the symptom was "works on the bench, dead under the unit" (#207). /dev/i2c-1 is
# root:i2c crw-rw----, and the PCA9685 behind every servo command is an I2C device — so
# without this the robot could not move AT ALL under systemd, while every bench run drove it
# correctly as the login user, which is in `i2c`.
SupplementaryGroups=video gpio audio i2c
# Creates /var/lib/robot (owned by the service user) for the on-device SQLite DB
# — config/pi.toml [memory] db_path = /var/lib/robot/robot.db. Written at M2+.
StateDirectory=robot

[Install]
WantedBy=multi-user.target
